{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.vue", "caido.config.ts", "tailwind.config.ts", "vitest.config.ts"]
}
